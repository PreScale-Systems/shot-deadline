# Gemini
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
TRIAGE_MODEL=gemini-2.5-pro
PLANNER_MODEL=gemini-2.5-pro

# Grafana Cloud — used by the MCP server (agent) and the provisioning script
GRAFANA_URL=https://yourstack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
MCP_GRAFANA_BIN=/usr/local/bin/mcp-grafana

# Grafana Cloud OTLP gateway — used by the telemetry emitter
# From Grafana Cloud → your stack → OpenTelemetry → Configure
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Emitter: run the production simulation inside the app (true) or only serve the board
EMIT=true
# Real seconds per simulated production hour
TICK_SECONDS=10
