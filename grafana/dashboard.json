{
 "uid": "shot-deadline",
 "title": "IRONWAKE \u2014 Shot Deadline",
 "tags": [
  "vfx",
  "shot-deadline"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "name": "Triage",
    "type": "tags",
    "tags": [
     "shot-deadline"
    ],
    "iconColor": "red"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Days to picture lock",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "vfx_sequence_days_to_lock",
     "legendFormat": "{{sequence}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 7
       },
       {
        "color": "green",
        "value": 12
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "Shots past due",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "count(vfx_shot_days_to_due < 0) by (sequence)",
     "legendFormat": "{{sequence}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Render failures (30m)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(render_jobs_failed_total[30m])) by (vendor)",
     "legendFormat": "{{vendor}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "title": "Shots by status \u2014 SEQ040",
   "type": "barchart",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(vfx_shots{sequence=\"SEQ040\"}) by (status, vendor)",
     "legendFormat": "{{vendor}} {{status}}",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "id": 5,
   "title": "Render queue depth by farm",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "render_queue_depth",
     "legendFormat": "{{farm}}"
    }
   ]
  },
  {
   "id": 6,
   "title": "Failures by node and error (30m)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(render_jobs_failed_total[30m])) by (node, error, vendor) > 0",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "id": 7,
   "title": "GPU utilisation by farm",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "avg(gpu_utilization_ratio) by (farm)",
     "legendFormat": "{{farm}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Review turnaround",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 18,
    "y": 13,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "review_turnaround_hours",
     "legendFormat": "{{vendor}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Render log",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "{service_name=\"ironwake-vfx-pipeline\"} |= \"RENDER FAILED\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}